NEXT_PUBLIC_APP_NAME="Invoice Management"

# Google Drive (OAuth as your dedicated Google account)
# Folder ID = the last part of the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Get this by running: npm run google:auth
GOOGLE_REFRESH_TOKEN=

# PostgreSQL (e.g. Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used by `npm run db:push`).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Keep at 4 or lower on Vercel's free plan (request/response bodies are limited to 4.5 MB).
MAX_FILE_SIZE_MB=4

# Secret used to sign login sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
