NEXT_PUBLIC_APP_NAME="Invoice Management"

# Google Drive (OAuth as your dedicated Google account)
# Folder ID = the last part of the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Get this by running: npm run google:auth
GOOGLE_REFRESH_TOKEN=

# MongoDB Atlas connection string. It must include the database name (here: invoices) before the "?".
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/invoices?retryWrites=true&w=majority"

# Keep at 4 or lower on Vercel's free plan (request/response bodies are limited to 4.5 MB).
MAX_FILE_SIZE_MB=4

# Secret used to sign login sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
