generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Invoice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String
  endDate       DateTime?
  description   String?
  tags          String? // comma-separated, e.g. "office,2026"
  fileId        String // Google Drive file ID
  fileName      String
  mimeType      String
  createdAt     DateTime  @default(now())
}


model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String // scrypt, format: salt:hash (hex)
  createdAt    DateTime @default(now())
}
